      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.02x21vi0kzbu7615y543507wo23e].[usr:Calculation_0073944828067845:qk]&quot;' value='% of Total' />
          <alias key='&quot;[federated.02x21vi0kzbu7615y543507wo23e].[usr:Calculation_0328821818454027:qk:1]&quot;' value='Rank By Amount' />
          <alias key='&quot;[federated.02x21vi0kzbu7615y543507wo23e].[usr:Calculation_0328821818454027:qk:14]&quot;' value='Cat Rank' />
          <alias key='&quot;[federated.02x21vi0kzbu7615y543507wo23e].[usr:Calculation_0328821818454027:qk:8]&quot;' value='Rank' />
        </aliases>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_0328821818454027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([amount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Upper Bound' datatype='real' name='[Calculation_1201766565949443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([amount]) + [Parameters].[Parameter 1] * STDEV([amount])' />
      </column>
      <column caption='Lower Bound' datatype='real' name='[Calculation_1201766567247876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([amount]) - [Parameters].[Parameter 1] * STDEV([amount])' />
      </column>
      <column caption='Amount Mannual Bins' datatype='integer' name='[Calculation_1201766573334534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([amount]/5)* 5' />
      </column>
      <column caption='Sort By Measure' datatype='real' name='[Calculation_1201766602731533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Amount&apos; THEN sum([amount])&#13;&#10;END' />
      </column>
      <column caption='Dynamic Sorting (M)' datatype='integer' name='[Calculation_1201766603489294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Asc&apos; THEN RANK_UNIQUE([Calculation_1201766602731533], &apos;asc&apos;)&#13;&#10;ELSE RANK_UNIQUE([Calculation_1201766602731533],&apos;desc&apos;)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Upper Bound Filter' datatype='boolean' name='[Calculation_1201766617251856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[amount] &gt; {FIXED : [Calculation_1201766565949443]}' />
      </column>
      <column caption='Cat or Ven Sheet' datatype='string' name='[Calculation_3329596743958528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vendor] = &apos;All&apos; THEN&#13;&#10;  &quot;&lt;Sheet name=&apos;Top 5 Amounts per Category&apos; maxwidth=&apos;900&apos; maxheight=&apos;700&apos; filter=&apos;&lt;All Fields&gt;&apos;&gt;&quot;&#13;&#10;ELSE&#13;&#10;   &quot;&lt;Sheet name=&apos;Top 5 Amounts per Ven&apos; maxwidth=&apos;900&apos; maxheight=&apos;700&apos; filter=&apos;&lt;All Fields&gt;&apos;&gt;&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' datatype-customized='true' name='[Year Month (date)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;1970-&quot; + [year_month] + &quot;-01&quot;' />
      </column>
